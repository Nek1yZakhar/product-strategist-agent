# Environment Variables Template
# Copy this file to .env. API keys are strictly ignored by Git and never committed.
# Primary agent workflows operate directly inside AntiGravity IDE and Zcode via active Pro subscriptions.
# The keys below are optional and used only for external headless Python CLI scripts.

# Google AI Studio Free-Tier API Key (Optional for standalone CLI scripts)
GEMINI_API_KEY=

# Zhipu AI / GLM API Key (Optional for direct CLI invocation)
GLM_API_KEY=

# Contest Environment Configuration
CONTEST_TRACK=megafon_product_factory
DEFAULT_MODEL=gemini-3.8-flash
LOG_LEVEL=INFO
